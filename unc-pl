<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Spieltagsplaner</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<!-- Firebase (kostenlose Cloud-Datenbank, damit alle Teammitglieder denselben Stand sehen) -->
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
<style>
  :root {
    --bg: #f3f4f8;
    --panel: #ffffff;
    --panel-alt: #ecedf4;
    --border: #dcdfea;
    --text: #14161f;
    --text-dim: #6b7080;
    --accent: #c9781f;
    --accent-strong: #a9620f;
    --ok: #1f8a5f;
    --ok-bg: #e3f5ec;
    --no: #c23b3b;
    --no-bg: #fbe7e7;
    --maybe: #b8860a;
    --maybe-bg: #faf1d9;
    --unset-bg: #eef0f6;
    --shadow: 0 1px 2px rgba(20,22,31,0.06), 0 8px 24px rgba(20,22,31,0.06);
    --radius: 14px;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #12131a;
      --panel: #1b1d27;
      --panel-alt: #21232f;
      --border: #2d303e;
      --text: #eceef5;
      --text-dim: #9498ac;
      --accent: #e0a750;
      --accent-strong: #f0bd6c;
      --ok: #49c58a;
      --ok-bg: #123326;
      --no: #ea6767;
      --no-bg: #3a1c1c;
      --maybe: #e0bb4b;
      --maybe-bg: #362c11;
      --unset-bg: #262838;
      --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px rgba(0,0,0,0.35);
    }
  }
  :root[data-theme="dark"] {
    --bg: #12131a;
    --panel: #1b1d27;
    --panel-alt: #21232f;
    --border: #2d303e;
    --text: #eceef5;
    --text-dim: #9498ac;
    --accent: #e0a750;
    --accent-strong: #f0bd6c;
    --ok: #49c58a;
    --ok-bg: #123326;
    --no: #ea6767;
    --no-bg: #3a1c1c;
    --maybe: #e0bb4b;
    --maybe-bg: #362c11;
    --unset-bg: #262838;
    --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px rgba(0,0,0,0.35);
  }
  html, body {
    height: 100%;
  }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3, .display {
    font-family: "Space Grotesk", "Inter", system-ui, sans-serif;
  }
  a { color: inherit; }

  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 20px 20px 64px;
  }

  header.top {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .top-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .brand .mark {
    width: 10px; height: 10px;
    border-radius: 3px;
    background: var(--accent);
    display: inline-block;
    transform: rotate(45deg);
    flex: none;
  }
  .brand h1 {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.01em;
  }
  .brand .sub {
    color: var(--text-dim);
    font-size: 0.82rem;
  }
  .top-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  select, input[type=text], input[type=date] {
    background: var(--panel);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 8px 12px;
    font-size: 0.88rem;
    font-family: inherit;
  }
  select:focus, input:focus, button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  button {
    font-family: inherit;
    cursor: pointer;
  }
  .btn {
    background: var(--panel);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 8px 14px;
    font-size: 0.86rem;
    font-weight: 500;
    transition: border-color 0.15s ease;
  }
  .btn:hover { border-color: var(--accent); }
  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #1a1204;
    font-weight: 600;
  }
  .btn.primary:hover { background: var(--accent-strong); border-color: var(--accent-strong); }
  .btn.ghost {
    background: transparent;
  }
  .btn.small { padding: 5px 10px; font-size: 0.78rem; border-radius: 7px; }
  .btn.danger { color: var(--no); }

  .intro {
    margin: 24px 0 20px;
  }
  .intro h2 { font-size: 1.3rem; margin: 0 0 6px; }
  .intro p { color: var(--text-dim); margin: 0; font-size: 0.92rem; max-width: 62ch; }

  .roster-bar {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 18px 0 26px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 11px;
    border-radius: 999px;
    background: var(--panel);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--text-dim);
  }
  .chip .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--text-dim); }
  .chip.start .dot { background: var(--accent); }
  .chip strong { color: var(--text); font-weight: 600; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }

  .card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 16px 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
  }
  .card-head h3 { margin: 0; font-size: 1rem; font-weight: 600; }
  .card-head .meta { color: var(--text-dim); font-size: 0.8rem; margin-top: 2px; }
  .status-pill {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 4px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .status-pill.good { background: var(--ok-bg); color: var(--ok); }
  .status-pill.warn { background: var(--maybe-bg); color: var(--maybe); }
  .status-pill.bad { background: var(--no-bg); color: var(--no); }
  .status-pill.neutral { background: var(--unset-bg); color: var(--text-dim); }

  .card.result-win { border-color: var(--ok); }
  .card.result-lose { border-color: var(--no); }

  .result-block {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 0.84rem;
  }
  .result-block select {
    padding: 5px 8px;
    font-size: 0.82rem;
  }
  .result-label { color: var(--text-dim); }
  .result-line {
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 8px;
  }
  .result-line.win { background: var(--ok-bg); color: var(--ok); }
  .result-line.lose { background: var(--no-bg); color: var(--no); }

  .role-icon {
    width: 15px;
    height: 15px;
    object-fit: contain;
    flex: none;
  }

  .edit-row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .edit-row input { flex: 1; min-width: 90px; }

  .players {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .prow {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border-radius: 9px;
  }
  .prow.me { background: var(--panel-alt); }
  .prow .pname {
    font-size: 0.86rem;
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .prow .pname .role {
    font-size: 0.68rem;
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 1px 5px;
    flex: none;
  }
  .prow .pname span.nm {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .toggles {
    display: flex;
    gap: 3px;
  }
  .tbtn {
    width: 30px; height: 26px;
    border-radius: 7px;
    border: 1px solid var(--border);
    background: var(--unset-bg);
    color: var(--text-dim);
    font-size: 0.85rem;
    display: flex; align-items: center; justify-content: center;
    line-height: 1;
    transition: transform 0.1s ease;
  }
  .tbtn:hover { transform: translateY(-1px); }
  .tbtn.active.yes { background: var(--ok-bg); color: var(--ok); border-color: var(--ok); }
  .tbtn.active.maybe { background: var(--maybe-bg); color: var(--maybe); border-color: var(--maybe); }
  .tbtn.active.no { background: var(--no-bg); color: var(--no); border-color: var(--no); }

  .note-line {
    font-size: 0.74rem;
    color: var(--text-dim);
    padding-left: 8px;
    margin-top: -2px;
  }

  .divider { height: 1px; background: var(--border); margin: 2px 0; }

  .resched {
    font-size: 0.8rem;
  }
  .resched .req {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    background: var(--maybe-bg);
    color: var(--maybe);
    border-radius: 8px;
    padding: 6px 9px;
    margin-bottom: 6px;
  }
  .resched .req span { overflow: hidden; text-overflow: ellipsis; }
  .resched .req button {
    background: none; border: none; color: inherit; font-size: 0.9rem; padding: 0 2px;
  }
  .resched-form {
    display: flex;
    gap: 6px;
    margin-top: 4px;
  }
  .resched-form input { flex: 1; }

  .manage {
    display: none;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 18px;
    margin-bottom: 22px;
  }
  .manage.open { display: block; }
  .manage h3 { margin: 0 0 12px; font-size: 1rem; }
  .manage-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  @media (max-width: 700px) {
    .manage-cols { grid-template-columns: 1fr; }
  }
  .manage-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 10px; }
  .manage-item { display: flex; gap: 6px; align-items: center; }
  .manage-item input[type=text] { flex: 1; }
  .manage-item select { width: 110px; }

  footer.hint {
    text-align: center;
    color: var(--text-dim);
    font-size: 0.78rem;
    margin-top: 30px;
  }

  ::-webkit-scrollbar { height: 8px; width: 8px; }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

  .visually-empty {
    color: var(--text-dim);
    font-size: 0.85rem;
    padding: 30px 10px;
    text-align: center;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }
</style>
</head>
<body>

<header class="top">
  <div class="top-inner">
    <div class="brand">
      <span class="mark"></span>
      <div>
        <h1>Spieltagsplaner</h1>
        <div class="sub">Prime League &middot; Verfügbarkeit &amp; Verschiebungen</div>
      </div>
    </div>
    <div class="top-controls">
      <select id="whoami"></select>
      <button class="btn" id="themeBtn" type="button" title="Theme wechseln">◐</button>
      <button class="btn" id="manageBtn" type="button">Team verwalten</button>
    </div>
  </div>
</header>

<div class="wrap">

  <div class="intro">
    <h2>7 Spieltage im Blick</h2>
    <p>Jede*r trägt pro Spieltag ein, ob sie/er kann. Bei Bedarf springt automatisch sichtbar ein Ersatzspieler ein &ndash; und wer einen Termin verschieben möchte, stellt das hier direkt zur Diskussion.</p>
  </div>

  <div class="roster-bar" id="rosterBar"></div>

  <div class="manage" id="managePanel">
    <div class="manage-cols">
      <div>
        <h3>Spieler:innen</h3>
        <div class="manage-list" id="playerList"></div>
        <button class="btn small" id="addPlayer" type="button">+ Spieler:in hinzufügen</button>
      </div>
      <div>
        <h3>Spieltage</h3>
        <div class="manage-list" id="matchdayList"></div>
        <button class="btn small" id="addMatchday" type="button">+ Spieltag hinzufügen</button>
      </div>
    </div>
  </div>

  <div class="grid" id="grid"></div>

  <footer class="hint">Änderungen werden automatisch für das ganze Team gespeichert.</footer>
</div>

<script>
(function(){
  // ====== HIER DEINE FIREBASE-CONFIG EINFÜGEN (aus Firebase Console → Web-App) ======
  const FIREBASE_CONFIG = {
    apiKey: "AIzaSyA0wZkoPzo7JV_lltmEzNoekZyTf61ahhI",
    authDomain: "unc-spielplanung.firebaseapp.com",
    projectId: "unc-spielplanung",
    storageBucket: "unc-spielplanung.firebasestorage.app",
    messagingSenderId: "483396227510",
    appId: "1:483396227510:web:f43470bee9031882edf117"
  };
  // ===================================================================================
  //
  // Firestore-Regeln (Firebase Console → Firestore Database → Tab "Regeln"):
  //
  // rules_version = '2';
  // service cloud.firestore {
  //   match /databases/{database}/documents {
  //     match /team/{doc} {
  //       allow read, write: if request.auth != null;
  //     }
  //   }
  // }
  //
  // Dazu unter Authentication → Sign-in method den Anbieter "Anonymous" aktivieren.

const ICON_TOP = "data:image/webp;base64,";
const ICON_JUNGLE = "data:image/webp;base64,";
const ICON_MID = "data:image/webp;base64,";
const ICON_BOTTOM = "data:image/webp;base64,";
const ICON_SUPPORT = "data:image/webp;base64,";

  const LANES = [
    { id: "top", label: "Top", icon: ICON_TOP },
    { id: "jungle", label: "Jungle", icon: ICON_JUNGLE },
    { id: "mid", label: "Mid", icon: ICON_MID },
    { id: "bottom", label: "Bot", icon: ICON_BOTTOM },
    { id: "support", label: "Support", icon: ICON_SUPPORT }
  ];
  function laneById(id){ return LANES.find(l => l.id === id) || null; }

  const STATUS_ORDER = ["yes","maybe","no"];
  const STATUS_ICON = { yes: "✓", maybe: "?", no: "✕" };
  let state = null;
  let dbRef = null;
  let manageOpen = false;
  let subscribed = false;
  const editingResults = new Set(); // rein lokal, nicht gespeichert

  function uid(prefix){
    return prefix + "_" + Math.random().toString(36).slice(2,9) + Date.now().toString(36).slice(-4);
  }

  function defaultState(){
    const players = [];
    for (let i=1;i<=5;i++) players.push({id: uid("p"), name: "Spieler " + i, role: "start", lane: null});
    players.push({id: uid("p"), name: "Sub 1", role: "sub", lane: null});
    const matchdays = [];
    for (let i=1;i<=7;i++) matchdays.push({id: uid("md"), label: "Spieltag " + i, date: "", time: "", opponent: "", reschedule: [], result: null});
    return { players, matchdays, availability: {} };
  }

  function cloneState(s){ return JSON.parse(JSON.stringify(s)); }

  function getMe(){
    try { return localStorage.getItem("splan_me") || ""; } catch(e){ return ""; }
  }
  function setMe(id){
    try { localStorage.setItem("splan_me", id); } catch(e){}
  }
  function getTheme(){
    try { return localStorage.getItem("splan_theme") || ""; } catch(e){ return ""; }
  }
  function setTheme(t){
    try { localStorage.setItem("splan_theme", t); } catch(e){}
    if (t) document.documentElement.setAttribute("data-theme", t);
    else document.documentElement.removeAttribute("data-theme");
  }

  function fmtDate(iso){
    if (!iso) return "Datum offen";
    const d = new Date(iso + "T00:00:00");
    if (isNaN(d)) return iso;
    return d.toLocaleDateString("de-DE", { weekday: "short", day: "2-digit", month: "2-digit", year: "numeric" });
  }

  function playerById(id){
    return (state.players || []).find(p => p.id === id);
  }

  async function persist(newState){
    state = newState;
    render();
    if (!dbRef) return;
    try {
      await dbRef.set(newState);
    } catch(e){
      console.error("Speichern fehlgeschlagen", e);
      alert("Speichern hat nicht geklappt. Prüfe die Internetverbindung bzw. die Firebase-Konfiguration.");
    }
  }

  function setAvailability(matchdayId, playerId, status){
    const s = cloneState(state);
    s.availability[matchdayId] = s.availability[matchdayId] || {};
    const cur = s.availability[matchdayId][playerId] || {};
    let newStatus = cur.status === status ? null : status;
    // note field only makes sense for "unsicher" / "kann nicht" – clear it once confirmed available
    let newNote = (newStatus === "yes") ? "" : (cur.note || "");
    s.availability[matchdayId][playerId] = { status: newStatus, note: newNote };
    persist(s);
  }

  function setNote(matchdayId, playerId, note){
    const s = cloneState(state);
    s.availability[matchdayId] = s.availability[matchdayId] || {};
    const cur = s.availability[matchdayId][playerId] || {};
    s.availability[matchdayId][playerId] = { status: cur.status || null, note: note };
    persist(s);
  }

  function setResult(matchdayId, us, them){
    const s = cloneState(state);
    const md = s.matchdays.find(m => m.id === matchdayId);
    if (!md) return;
    md.result = { us: us, them: them };
    editingResults.delete(matchdayId);
    persist(s);
  }

  function clearResult(matchdayId){
    const s = cloneState(state);
    const md = s.matchdays.find(m => m.id === matchdayId);
    if (!md) return;
    md.result = null;
    editingResults.delete(matchdayId);
    persist(s);
  }

  function addReschedule(matchdayId, reason){
    const me = getMe();
    if (!me){ alert("Bitte oben zuerst auswählen, wer du bist."); return; }
    const s = cloneState(state);
    const md = s.matchdays.find(m => m.id === matchdayId);
    if (!md) return;
    md.reschedule = md.reschedule || [];
    md.reschedule = md.reschedule.filter(r => r.playerId !== me);
    md.reschedule.push({ playerId: me, reason: reason || "" });
    persist(s);
  }

  function removeReschedule(matchdayId, playerId){
    const s = cloneState(state);
    const md = s.matchdays.find(m => m.id === matchdayId);
    if (!md) return;
    md.reschedule = (md.reschedule || []).filter(r => r.playerId !== playerId);
    persist(s);
  }

  function addPlayer(){
    const s = cloneState(state);
    s.players.push({ id: uid("p"), name: "Neue*r Spieler*in", role: "sub" });
    persist(s);
  }
  function updatePlayer(id, field, value){
    const s = cloneState(state);
    const p = s.players.find(p => p.id === id);
    if (!p) return;
    p[field] = value;
    persist(s);
  }
  function removePlayer(id){
    const s = cloneState(state);
    s.players = s.players.filter(p => p.id !== id);
    Object.keys(s.availability || {}).forEach(mdId => {
      if (s.availability[mdId]) delete s.availability[mdId][id];
    });
    (s.matchdays || []).forEach(md => {
      md.reschedule = (md.reschedule || []).filter(r => r.playerId !== id);
    });
    persist(s);
    if (getMe() === id) setMe("");
  }

  function addMatchday(){
    const s = cloneState(state);
    const n = s.matchdays.length + 1;
    s.matchdays.push({ id: uid("md"), label: "Spieltag " + n, date: "", opponent: "", reschedule: [] });
    persist(s);
  }
  function updateMatchday(id, field, value){
    const s = cloneState(state);
    const md = s.matchdays.find(m => m.id === id);
    if (!md) return;
    md[field] = value;
    persist(s);
  }
  function removeMatchday(id){
    const s = cloneState(state);
    s.matchdays = s.matchdays.filter(m => m.id !== id);
    delete s.availability[id];
    persist(s);
  }

  function renderWhoAmI(){
    const sel = document.getElementById("whoami");
    const me = getMe();
    sel.innerHTML = "";
    const optNone = document.createElement("option");
    optNone.value = "";
    optNone.textContent = "Wer bist du?";
    sel.appendChild(optNone);
    (state.players || []).forEach(p => {
      const o = document.createElement("option");
      o.value = p.id;
      o.textContent = (p.name || "—") + (p.role === "sub" ? " (Ersatz)" : "");
      if (p.id === me) o.selected = true;
      sel.appendChild(o);
    });
  }

  function renderRosterBar(){
    const bar = document.getElementById("rosterBar");
    bar.innerHTML = "";
    (state.players || []).forEach(p => {
      const chip = document.createElement("span");
      chip.className = "chip" + (p.role === "start" ? " start" : "");
      const lane = laneById(p.lane);
      const iconHtml = lane ? '<img class="role-icon" src="' + lane.icon + '" alt="' + lane.label + '" title="' + lane.label + '">' : '';
      chip.innerHTML = '<span class="dot"></span>' + iconHtml + '<strong>' + escapeHtml(p.name || "—") + '</strong> · ' + (p.role === "start" ? "Main" : "Sub");
      bar.appendChild(chip);
    });
    if (!(state.players || []).length){
      bar.innerHTML = '<span class="chip">Noch keine Spieler:innen &ndash; über „Team verwalten" hinzufügen</span>';
    }
  }

  function escapeHtml(str){
    return String(str || "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
  }

  function renderManage(){
    const playerList = document.getElementById("playerList");
    playerList.innerHTML = "";
    (state.players || []).forEach(p => {
      const row = document.createElement("div");
      row.className = "manage-item";
      row.innerHTML = `
        <input type="text" value="${escapeHtml(p.name)}" data-id="${p.id}" data-field="name">
        <select data-id="${p.id}" data-field="lane" style="width:120px">
          <option value="" ${!p.lane ? "selected" : ""}>Rolle wählen</option>
          ${LANES.map(l => `<option value="${l.id}" ${p.lane === l.id ? "selected" : ""}>${l.label}</option>`).join("")}
        </select>
        <select data-id="${p.id}" data-field="role">
          <option value="start" ${p.role === "start" ? "selected" : ""}>Main</option>
          <option value="sub" ${p.role === "sub" ? "selected" : ""}>Sub</option>
        </select>
        <button class="btn small danger" data-remove="${p.id}" type="button">✕</button>
      `;
      playerList.appendChild(row);
    });
    playerList.querySelectorAll("input[data-field]").forEach(el => {
      el.addEventListener("change", () => updatePlayer(el.dataset.id, el.dataset.field, el.value));
    });
    playerList.querySelectorAll("select[data-field]").forEach(el => {
      el.addEventListener("change", () => updatePlayer(el.dataset.id, el.dataset.field, el.value));
    });
    playerList.querySelectorAll("[data-remove]").forEach(el => {
      el.addEventListener("click", () => { if(confirm("Spieler:in entfernen?")) removePlayer(el.dataset.remove); });
    });

    const mdList = document.getElementById("matchdayList");
    mdList.innerHTML = "";
    (state.matchdays || []).forEach(md => {
      const row = document.createElement("div");
      row.className = "manage-item";
      row.innerHTML = `
        <input type="text" value="${escapeHtml(md.label)}" data-id="${md.id}" data-field="label" style="max-width:100px">
        <input type="date" value="${escapeHtml(md.date)}" data-id="${md.id}" data-field="date">
        <input type="time" value="${escapeHtml(md.time || "")}" data-id="${md.id}" data-field="time" style="max-width:100px">
        <input type="text" placeholder="Gegner" value="${escapeHtml(md.opponent)}" data-id="${md.id}" data-field="opponent" style="max-width:110px">
        <button class="btn small danger" data-remove="${md.id}" type="button">✕</button>
      `;
      mdList.appendChild(row);
    });
    mdList.querySelectorAll("input[data-field]").forEach(el => {
      el.addEventListener("change", () => updateMatchday(el.dataset.id, el.dataset.field, el.value));
    });
    mdList.querySelectorAll("[data-remove]").forEach(el => {
      el.addEventListener("click", () => { if(confirm("Spieltag entfernen?")) removeMatchday(el.dataset.remove); });
    });
  }

  function renderGrid(){
    const grid = document.getElementById("grid");
    grid.innerHTML = "";
    const me = getMe();

    if (!(state.matchdays || []).length){
      grid.innerHTML = '<div class="visually-empty">Noch keine Spieltage angelegt. Über „Team verwalten" hinzufügen.</div>';
      return;
    }

    const sorted = [...state.matchdays].sort((a,b) => {
      if (a.date && b.date) return a.date.localeCompare(b.date);
      if (a.date) return -1;
      if (b.date) return 1;
      return 0;
    });

    sorted.forEach(md => {
      const avail = (state.availability && state.availability[md.id]) || {};
      const starters = (state.players || []).filter(p => p.role === "start");
      const subs = (state.players || []).filter(p => p.role === "sub");
      const yesStarters = starters.filter(p => (avail[p.id] || {}).status === "yes").length;
      const yesSubs = subs.filter(p => (avail[p.id] || {}).status === "yes").length;
      const anyResponse = [...starters, ...subs].some(p => (avail[p.id] || {}).status);
      const target = starters.length || 5;

      let pillClass = "neutral", pillText = "Noch offen";
      if (anyResponse){
        if (yesStarters >= target){
          pillClass = "good"; pillText = target + "/" + target + " bestätigt";
        } else if (yesStarters + yesSubs >= target){
          pillClass = "warn"; pillText = Math.min(yesStarters + yesSubs, target) + "/" + target + " bestätigt (mit Sub)";
        } else {
          pillClass = "bad"; pillText = (yesStarters + yesSubs) + "/" + target + " bestätigt";
        }
      }

      const result = md.result;
      const isWin = result ? result.us > result.them : null;
      const card = document.createElement("div");
      card.className = "card" + (result ? (isWin ? " result-win" : " result-lose") : "");

      const head = document.createElement("div");
      head.className = "card-head";
      head.innerHTML = `
        <div>
          <h3>${md.opponent ? "vs " + escapeHtml(md.opponent) : "Gegner offen"}</h3>
          <div class="meta">${escapeHtml(md.label)} · ${escapeHtml(fmtDate(md.date))}${md.time ? " · " + escapeHtml(md.time) + " Uhr" : ""}</div>
        </div>
        <div class="status-pill ${pillClass}">${pillText}</div>
      `;
      card.appendChild(head);
      card.appendChild(Object.assign(document.createElement("div"), {className:"divider"}));

      const resultBlock = document.createElement("div");
      resultBlock.className = "result-block";
      if (result && !editingResults.has(md.id)){
        resultBlock.innerHTML = `
          <span class="result-line ${isWin ? "win" : "lose"}">${result.us}:${result.them} ${isWin ? "gewonnen" : "verloren"}</span>
          <button class="btn small ghost" data-edit-result="${md.id}" type="button">Bearbeiten</button>
        `;
      } else {
        const preUs = result ? result.us : 0;
        const preThem = result ? result.them : 0;
        const opts = n => [0,1,2].map(v => `<option value="${v}" ${v === n ? "selected" : ""}>${v}</option>`).join("");
        resultBlock.innerHTML = `
          <span class="result-label">Ergebnis (Bo3):</span>
          <select data-res-us="${md.id}">${opts(preUs)}</select>
          <span>:</span>
          <select data-res-them="${md.id}">${opts(preThem)}</select>
          <button class="btn small" data-save-result="${md.id}" type="button">Speichern</button>
        `;
      }
      card.appendChild(resultBlock);
      card.appendChild(Object.assign(document.createElement("div"), {className:"divider"}));

      const playersWrap = document.createElement("div");
      playersWrap.className = "players";
      [...starters, ...subs].forEach(p => {
        const entry = avail[p.id] || {};
        const lane = laneById(p.lane);
        const row = document.createElement("div");
        row.className = "prow" + (p.id === me ? " me" : "");
        const toggles = STATUS_ORDER.map(st => {
          const active = entry.status === st ? " active " + st : "";
          return `<button class="tbtn${active}" data-md="${md.id}" data-p="${p.id}" data-status="${st}" title="${st === 'yes' ? 'Kann' : st === 'maybe' ? 'Unsicher' : 'Kann nicht'}">${STATUS_ICON[st]}</button>`;
        }).join("");
        const iconHtml = lane ? '<img class="role-icon" src="' + lane.icon + '" alt="' + lane.label + '" title="' + lane.label + '">' : '';
        row.innerHTML = `
          <div class="pname">${iconHtml}<span class="nm">${escapeHtml(p.name)}</span><span class="role">${p.role === "start" ? "Main" : "Sub"}</span></div>
          <div class="toggles">${toggles}</div>
        `;
        playersWrap.appendChild(row);
        const needsNote = entry.status === "no" || entry.status === "maybe";
        if (p.id === me && needsNote){
          const noteRow = document.createElement("input");
          noteRow.type = "text";
          noteRow.placeholder = "Notiz (optional, z. B. Grund)";
          noteRow.value = entry.note || "";
          noteRow.style.cssText = "width:100%;margin:2px 0 4px;font-size:0.78rem;padding:5px 8px;";
          noteRow.addEventListener("change", () => setNote(md.id, p.id, noteRow.value));
          playersWrap.appendChild(noteRow);
        } else if (p.id !== me && entry.note && needsNote) {
          const noteLine = document.createElement("div");
          noteLine.className = "note-line";
          noteLine.textContent = "„" + entry.note + "“";
          playersWrap.appendChild(noteLine);
        }
      });
      card.appendChild(playersWrap);

      card.appendChild(Object.assign(document.createElement("div"), {className:"divider"}));

      const resched = document.createElement("div");
      resched.className = "resched";
      const reqs = md.reschedule || [];
      let reqHtml = "";
      reqs.forEach(r => {
        const p = playerById(r.playerId);
        reqHtml += `<div class="req"><span>${escapeHtml(p ? p.name : "?")} möchte verschieben${r.reason ? ": " + escapeHtml(r.reason) : ""}</span><button data-remove-req="${r.playerId}" data-md="${md.id}" title="Zurückziehen">✕</button></div>`;
      });
      resched.innerHTML = reqHtml + `
        <div class="resched-form">
          <input type="text" placeholder="Verschiebung anfragen – kurzer Grund" data-reason="${md.id}">
          <button class="btn small" data-ask="${md.id}" type="button">Anfragen</button>
        </div>
      `;
      card.appendChild(resched);

      grid.appendChild(card);
    });

    grid.querySelectorAll(".tbtn").forEach(btn => {
      btn.addEventListener("click", () => setAvailability(btn.dataset.md, btn.dataset.p, btn.dataset.status));
    });
    grid.querySelectorAll("[data-ask]").forEach(btn => {
      btn.addEventListener("click", () => {
        const input = grid.querySelector('[data-reason="' + btn.dataset.ask + '"]');
        addReschedule(btn.dataset.ask, input ? input.value : "");
        if (input) input.value = "";
      });
    });
    grid.querySelectorAll("[data-remove-req]").forEach(btn => {
      btn.addEventListener("click", () => removeReschedule(btn.dataset.md, btn.dataset.removeReq));
    });
    grid.querySelectorAll("[data-save-result]").forEach(btn => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.saveResult;
        const usSel = grid.querySelector('[data-res-us="' + id + '"]');
        const themSel = grid.querySelector('[data-res-them="' + id + '"]');
        const us = parseInt(usSel.value, 10);
        const them = parseInt(themSel.value, 10);
        const valid = (us === 2 && them < 2) || (them === 2 && us < 2);
        if (!valid){
          alert("Kein gültiges Bo3-Ergebnis. Ein Team muss 2 Siege haben, das andere 0 oder 1 (z. B. 2:1 oder 0:2).");
          return;
        }
        setResult(id, us, them);
      });
    });
    grid.querySelectorAll("[data-edit-result]").forEach(btn => {
      btn.addEventListener("click", () => {
        editingResults.add(btn.dataset.editResult);
        render();
      });
    });
  }

  function render(){
    if (!state) return;
    renderWhoAmI();
    renderRosterBar();
    renderManage();
    renderGrid();
  }

  async function init(){
    const savedTheme = getTheme();
    if (savedTheme) setTheme(savedTheme);

    document.getElementById("themeBtn").addEventListener("click", () => {
      const cur = document.documentElement.getAttribute("data-theme");
      setTheme(cur === "dark" ? "light" : cur === "light" ? "" : "dark");
    });
    document.getElementById("manageBtn").addEventListener("click", () => {
      manageOpen = !manageOpen;
      document.getElementById("managePanel").classList.toggle("open", manageOpen);
      document.getElementById("manageBtn").textContent = manageOpen ? "Fertig" : "Team verwalten";
    });
    document.getElementById("whoami").addEventListener("change", (e) => {
      setMe(e.target.value);
      render();
    });
    document.getElementById("addPlayer").addEventListener("click", addPlayer);
    document.getElementById("addMatchday").addEventListener("click", addMatchday);

    // render an initial local default immediately so the page never looks blank
    state = defaultState();
    render();

    if (!FIREBASE_CONFIG.apiKey || FIREBASE_CONFIG.apiKey === "DEIN_API_KEY"){
      console.warn("Firebase ist noch nicht konfiguriert – trage FIREBASE_CONFIG oben im <script> ein.");
      document.querySelector(".intro p").innerHTML =
        '⚠️ Firebase ist noch nicht konfiguriert. Trage im HTML-Quelltext oben im &lt;script&gt; deine FIREBASE_CONFIG ein, damit Änderungen für alle gespeichert werden. Bis dahin läuft die Seite nur lokal in diesem Browser-Tab.';
      return;
    }

    try {
      firebase.initializeApp(FIREBASE_CONFIG);
      const auth = firebase.auth();
      const firestore = firebase.firestore();
      dbRef = firestore.collection("team").doc("state");

      auth.onAuthStateChanged((user) => {
        if (!user || subscribed) return;
        subscribed = true;
        let seeded = false;
        dbRef.onSnapshot((snap) => {
          if (snap.exists && snap.data()){
            state = snap.data();
            render();
          } else if (!seeded) {
            seeded = true;
            const seed = defaultState();
            dbRef.set(seed).catch(e => console.error(e));
          }
        }, (err) => {
          console.error("Firestore-Fehler", err);
        });
      });

      auth.signInAnonymously().catch((e) => {
        console.error("Anmeldung fehlgeschlagen", e);
        alert("Anmeldung bei Firebase fehlgeschlagen. Ist \"Anonymous\" unter Authentication → Sign-in method aktiviert?");
      });
    } catch(e){
      console.error("Firebase-Init fehlgeschlagen", e);
    }
  }

  init();
})();
</script>
</body>
</html>
